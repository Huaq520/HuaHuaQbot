# ===== 基础 =====
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# 主人 QQ（最高权限，可多个）
SUPERUSERS=["123456789"]

# 斜杠命令前缀
COMMAND_START=["/"]

# 与 NapCat 侧必须一致
ONEBOT_ACCESS_TOKEN="change-me-to-a-random-string"

# ===== 模型 =====
DEEPSEEK_API_KEY="sk-your-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_MAX_HISTORY="6"

# @ 唤醒后的活跃窗口（秒）
AI_WAKE_SECONDS="300"

# ===== 日志 =====
LOG_LEVEL=INFO
